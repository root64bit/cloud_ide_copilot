# ==============================================================================
# AI Engineering Platform Environment Variables
# NOTE: Never commit real production secrets to version control.
# Copy this file to .env.local and fill in your actual values.
# ==============================================================================

# SaaS Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Supabase Auth & Multi-Tenant PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Vercel Integration
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# Vercel Sandbox (@vercel/sandbox)
VERCEL_SANDBOX_TOKEN=

# Sentry Webhook Ingestion
SENTRY_WEBHOOK_SECRET=

# OpenRouter LLM Gateway
OPENROUTER_API_KEY=
# Optional default. `openrouter/auto` avoids hard-coding a stale model slug.
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_ANALYSIS_MODEL=
OPENROUTER_CODING_MODEL=
OPENROUTER_REVIEW_MODEL=
OPENROUTER_FAST_MODEL=
# Tests only. Never enable this in Vercel Production.
ALLOW_MOCK_PROVIDERS=false

# OpenHands Cloud Coding Agent (real V1 API)
OPENHANDS_API_URL=https://app.all-hands.dev
OPENHANDS_API_KEY=
# Optional alias also accepted by the runtime:
OPENHANDS_CLOUD_API_KEY=
# Optional: omit to use the model/profile configured in your OpenHands account.
OPENHANDS_MODEL=
OPENHANDS_GIT_WORKSPACE_PATH=/workspace/project
OPENHANDS_START_TIMEOUT_MS=300000
OPENHANDS_EXECUTION_TIMEOUT_MS=2700000
OPENHANDS_POLL_INTERVAL_MS=5000

# Trigger.dev Workflow Orchestration
# Use the DEV key locally and the PROD key in Vercel Production.
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# Browser IDE (code-server)
CODE_SERVER_BASE_DOMAIN=
CODE_SERVER_SHARED_SECRET=

# TencentDB Agent Memory (Phase 2)
TENCENT_AGENT_MEMORY_SECRET_ID=
TENCENT_AGENT_MEMORY_SECRET_KEY=
TENCENT_AGENT_MEMORY_REGION=ap-guangzhou
