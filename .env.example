# ==============================================================================
# AI Engineering Platform Environment Variables
# NOTE: Never commit real production secrets to version control.
# ==============================================================================

# SaaS Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Supabase Auth & Multi-Tenant PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# GitHub App Integration
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv1.yourclientid
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET=your-github-webhook-secret

# Vercel Integration
VERCEL_API_TOKEN=your-vercel-api-token
VERCEL_TEAM_ID=team_yourteamid

# Vercel Sandbox (@vercel/sandbox)
VERCEL_SANDBOX_TOKEN=your-vercel-sandbox-token

# Sentry Webhook Ingestion
SENTRY_WEBHOOK_SECRET=your-sentry-webhook-signing-secret

# OpenRouter LLM Gateway
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_ANALYSIS_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_CODING_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_REVIEW_MODEL=openai/gpt-4o
OPENROUTER_FAST_MODEL=openai/gpt-4o-mini

# OpenHands Coding Agent API (optional / self-hosted or cloud)
OPENHANDS_API_URL=http://localhost:3001
OPENHANDS_API_KEY=your-openhands-api-key

# Trigger.dev Workflow Orchestration
TRIGGER_SECRET_KEY=tr_dev_yourtriggersecretkey
TRIGGER_API_URL=https://api.trigger.dev

# Browser IDE (code-server)
CODE_SERVER_BASE_DOMAIN=ide.engineering.example.com
CODE_SERVER_SHARED_SECRET=your-code-server-shared-secret

# TencentDB Agent Memory (Phase 2)
TENCENT_AGENT_MEMORY_SECRET_ID=your-tencent-secret-id
TENCENT_AGENT_MEMORY_SECRET_KEY=your-tencent-secret-key
TENCENT_AGENT_MEMORY_REGION=ap-guangzhou
