# Public app URL
NEXT_PUBLIC_APP_URL=https://cloud-ide-copilot.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Required only when GitHub user-authorization/OAuth is enabled for secure public-SaaS installation binding.
GITHUB_APP_CLIENT_SECRET=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_ANALYSIS_MODEL=
OPENROUTER_CODING_MODEL=
OPENROUTER_REVIEW_MODEL=
OPENROUTER_FAST_MODEL=

# OpenHands Cloud
OPENHANDS_API_KEY=
OPENHANDS_API_URL=https://app.all-hands.dev
OPENHANDS_MODEL=

# Trigger.dev
TRIGGER_SECRET_KEY=

# Sentry webhook
SENTRY_WEBHOOK_SECRET=

# Vercel deployment discovery / external SDK auth fallback.
# Vercel-hosted Sandbox calls should use deployment OIDC automatically; do not manually set VERCEL_OIDC_TOKEN.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Explicit local/test-only switches. Never enable these in production.
ALLOW_DEV_AUTH=false
DEV_USER_ID=
DEV_USER_EMAIL=
ALLOW_MOCK_PROVIDERS=false
